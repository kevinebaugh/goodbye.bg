{
  "name": "goodbye.bg",
  "version": "0.1.0",
  "private": true,
  "description": "Background removal that runs in your browser. Photos are cut out on the device.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "deploy": "node scripts/build.mjs && wrangler pages deploy dist --project-name goodbye-bg-git --branch main"
  },
  "devDependencies": {
    "@imgly/background-removal-data": "1.4.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "libheif-js": "1.23.5",
    "onnxruntime-web": "1.31.1",
    "utif2": "4.1.0",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "canvas-confetti": "1.9.4",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "three": "0.187.0"
  }
}
