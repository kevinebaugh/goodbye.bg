{
  "name": "goodbye.bg",
  "short_name": "goodbye.bg",
  "description": "Say goodbye to the background. Runs on your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8f0",
  "theme_color": "#69d2e7",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*",
            ".heic",
            ".heif",
            ".tif",
            ".tiff",
            ".zip",
            "application/zip",
            ".dng",
            ".cr2",
            ".cr3",
            ".nef",
            ".arw",
            ".raf",
            ".orf",
            ".rw2",
            ".pef",
            ".srw"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [
          ".arw",
          ".avif",
          ".bmp",
          ".cr2",
          ".cr3",
          ".dng",
          ".gif",
          ".heic",
          ".heif",
          ".jpeg",
          ".jpg",
          ".nef",
          ".orf",
          ".pef",
          ".png",
          ".raf",
          ".rw2",
          ".srw",
          ".svg",
          ".tif",
          ".tiff",
          ".webp"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ]
}
